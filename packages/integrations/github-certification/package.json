{
  "name": "@trick-harness/github-certification",
  "description": "Scoped GitHub certification for Trick Harness: publish one commit status against a verified pull-request head, and nothing wider",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@trick-harness/contracts": "workspace:^",
    "@trick-harness/engineering-workflow": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@trick-harness/contracts": "workspace:^",
    "@trick-harness/engineering-workflow": "workspace:^"
  }
}
