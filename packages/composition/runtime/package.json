{
  "name": "@trick-harness/composition",
  "description": "Composition root for Trick Harness: registers the executor runtime and the configured providers without starting a product process",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@trick-harness/executor": "workspace:^",
    "@trick-harness/profile": "workspace:^",
    "@trick-harness/provider-codex": "workspace:^",
    "@trick-harness/provider-opencode": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@trick-harness/executor": "workspace:^",
    "@trick-harness/profile": "workspace:^",
    "@trick-harness/provider-codex": "workspace:^",
    "@trick-harness/provider-opencode": "workspace:^"
  }
}
